# Repository-wide rules. OCE_workflow/.gitignore adds the processing-specific ones.

# MATLAB autosave and temporary files
*.asv
*.m~
*.mlx.autosave
*.mex*
slprj/
codegen/

# Raw data and generated results should not live in this repository
Data/
data/
Results/
results/
*.bin
*.avi
*.mp4
*.tif
*.tiff
*.fig

# Raw OCT acquisitions (GBs per run) - keep on institutional storage
*.tdms
*.tdms_index
raw/
**/raw/

# MAT files are ignored by default because many are experiment-specific or heavy
*.mat

# LabVIEW
*.aliases
*.lvlps
.cache/
builds/

# Python
__pycache__/
*.py[cod]
.venv/
.ipynb_checkpoints/

# CAD backups
*.f3d.bak

# OS / editor files
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~
~$*
